# Application
NODE_ENV=test
PORT=7701
API_BASE_URL=http://localhost:7701
CORS_ORIGINS=http://localhost:3000

# Database (use a dedicated test DB — never production)
MONGODB_URI=mongodb://127.0.0.1:27017/validation-portal-test

# JWT
JWT_ACCESS_SECRET=test-jwt-access-secret-do-not-use-in-production
JWT_EXPIRES_IN=1h

# Cloudinary (safe placeholders for unit/e2e)
CLOUDINARY_CLOUD_NAME=test_cloud
CLOUDINARY_API_KEY=test_key
CLOUDINARY_API_SECRET=test_secret

# Gmail OAuth (safe placeholders — mail should be mocked in tests)
CLIENT_ID=test_client_id
CLIENT_SECRET=test_client_secret
REDIRECT_URI=http://localhost/oauth
REFRESH_TOKEN=test_refresh_token
GMAIL_NAME=test@example.com

# Keep-alive disabled in tests
KEEP_ALIVE_URL=http://localhost:7701/api/v1/health
KEEP_ALIVE_ENABLED=false

# Rate limiting (relaxed for tests)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=1000

# Swagger
SWAGGER_ENABLED=false
SWAGGER_PATH=docs

# Seeder
SEED_ADMIN_EMAIL=admin@test.com
SEED_ADMIN_PASSWORD=TestAdmin123!
SEED_SUPER_ADMIN_EMAIL=supadmin@test.com
SEED_SUPER_ADMIN_PASSWORD=TestSupAdmin123!
