# Application
NODE_ENV=development
PORT=7700
API_BASE_URL=http://localhost:7700
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/validation-portal

# JWT
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Gmail OAuth (Nodemailer)
CLIENT_ID=your_google_oauth_client_id
CLIENT_SECRET=your_google_oauth_client_secret
REDIRECT_URI=https://developers.google.com/oauthplayground
REFRESH_TOKEN=your_google_oauth_refresh_token
GMAIL_NAME=noreply@example.com

# Keep-alive (Render / free-tier ping) — use a public URL, never credentials
KEEP_ALIVE_URL=http://localhost:7700/api/v1/health
KEEP_ALIVE_ENABLED=true

# Rate limiting
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Swagger
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# Seeder (optional — only used by yarn seed)
SEED_ADMIN_EMAIL=admin@gmail.com
SEED_ADMIN_PASSWORD=change-me
SEED_SUPER_ADMIN_EMAIL=supadmin@mail.com
SEED_SUPER_ADMIN_PASSWORD=change-me
